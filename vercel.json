{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "keepslow.co.kr" }],
      "destination": "https://keepslow.kr/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.keepslow.co.kr" }],
      "destination": "https://keepslow.kr/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.keepslow.kr" }],
      "destination": "https://keepslow.kr/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/quiz",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/result",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/mypage",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/scent-quiz(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/auth/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sasang/:id", "destination": "/api/render?type=sasang&id=:id" },
    { "source": "/wellness/:id", "destination": "/api/render?type=wellness&id=:id" },
    { "source": "/test", "destination": "/test/index.html" },
    { "source": "/sasang", "destination": "/sasang/index.html" },
    { "source": "/wellness", "destination": "/wellness/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
